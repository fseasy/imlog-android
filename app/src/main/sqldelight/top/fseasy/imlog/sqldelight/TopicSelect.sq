--|==========
--| Plain Select
--|==========
--| topics queries
getTopicById:
SELECT * FROM topics WHERE id = ?;

-- Home Screen Topic list (get last messaage on the fly)
getCurrentUserHomeScreenTopics:
SELECT
    t.id,
    t.name,
    t.avatar_model,
    COALESCE(tps.pinned, 0) AS pinned,
    CASE
        WHEN m.created_at IS NULL THEN 0
        WHEN tms.last_read_at IS NULL THEN 1
        WHEN tms.last_read_at < m.created_at THEN 1
        ELSE 0
    END AS has_unread,
    -- for ui display and sort：if has message: m.created_at, else topic.created_at
    COALESCE(m.created_at, t.created_at) AS topic_message_update_at,
    -- for message snippet ui: 1. draft 2. last message 3. description
    tms.draft,
    m.type AS last_message_type,
    m.text AS last_message_text,
    sender.username AS last_message_sender_name,
    t.description
FROM topics t
INNER JOIN topic_members tm ON t.id = tm.topic_id AND tm.user_id = :currentUserId
LEFT JOIN topic_preference tps ON t.id = tps.topic_id AND tps.user_id = :currentUserId
LEFT JOIN topic_message_state tms ON t.id = tms.topic_id AND tms.user_id = :currentUserId
-- For last message (text part)
LEFT JOIN messages m ON m.id = (
    SELECT id FROM messages
    -- following condition & order will match the index
    WHERE
        topic_id = t.id
        AND is_deleted = 0
    ORDER BY created_at DESC, id DESC
    LIMIT 1
)
-- For last message (user part)
LEFT JOIN users sender ON sender.id = m.sender_id
WHERE
    COALESCE(tps.archived, 0) = 0
ORDER BY
    COALESCE(tps.pinned, 0) DESC,
    topic_message_update_at DESC,
    has_unread DESC;

--| topic_members queries
getMembersByTopicId:
SELECT * FROM topic_members WHERE topic_id = ?;

--| topic_preference queries
getPreference:
SELECT * FROM topic_preference WHERE topic_id = :topic_id AND user_id = :user_id;

--| topic-message-state queries
getMessageDraft:
SELECT draft
FROM topic_message_state
WHERE
    topic_id = :topicId
    AND user_id = :userId;