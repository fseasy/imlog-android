import kotlin.Boolean;
import top.fseasy.imlog.domain.model.MessageDraft;
import top.fseasy.imlog.domain.model.MessagePreview;
import top.fseasy.imlog.domain.model.TopicId;
import top.fseasy.imlog.domain.model.TopicMemberRole;
import top.fseasy.imlog.domain.model.UserId;

-- TODO
-- 在考虑数据同步的时候，数据库可能要重新设计，特别的，可能要把 delete 变成 soft-delete!
-- 当前阶段先不弄了（之前写了，但是后面忘了，就把 soft-delete 给去掉了。下次做操作前记得备注！）

-- share across all members
-- Topic 的删除逻辑：
-- - creator 才可以删除这个 topic；
-- - 如果 creator 注销了，不会自动删除起创建的 topic, 而是
--   1. 先将关联的 topic creator 设为 null; topic_members 删掉对应行
--   2. 然后定义了一个 trigger, 当 topic_members 删除时，看是否有 Topic 已经没有任何的 member 关联了，
--      这时才会触发删除！
CREATE TABLE topics (
    id TEXT AS TopicId NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    avatar_model TEXT NOT NULL,
    description TEXT,
    -- 注意！这里可以为空：因为当 creator 注销账户后，不能直接删除这个 Topic!
    -- 只有群成员全部注销后才能删除这个 Topic；对应到 Trigger 里基于 topic_members 的删除
    creator_id TEXT AS UserId REFERENCES users(id) ON DELETE SET NULL,
    created_at INTEGER NOT NULL,
    attributes_updated_at INTEGER NOT NULL
);

CREATE INDEX idx_topics_creator ON topics(creator_id);

-- share across all members
CREATE TABLE topic_members (
    -- 删除了 topic, 关联的记录全部删掉！
    topic_id TEXT AS TopicId NOT NULL REFERENCES topics(id) ON DELETE CASCADE,
    -- 删除了 user_id, 关联的 member 也要删
    user_id TEXT AS UserId NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    user_nickname TEXT,
    role TEXT AS TopicMemberRole NOT NULL,
    joined_at INTEGER NOT NULL,
    attributes_updated_at INTEGER NOT NULL,
    PRIMARY KEY (topic_id, user_id)
);

-- //  Private Datas. Bind to users. //
-- no sharing
CREATE TABLE topic_preference (
    -- 删除了 user / topic, 关联的个性化设置全部删掉！
    topic_id TEXT AS TopicId NOT NULL REFERENCES topics(id) ON DELETE CASCADE,
    user_id TEXT AS UserId NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    archived INTEGER AS Boolean NOT NULL DEFAULT 0,
    pinned INTEGER AS Boolean NOT NULL DEFAULT 0,
    background TEXT,
    attributes_updated_at INTEGER NOT NULL,
    PRIMARY KEY (topic_id, user_id)
);

CREATE TABLE topic_message_state (
    topic_id TEXT AS TopicId NOT NULL REFERENCES topics(id) ON DELETE CASCADE,
    user_id TEXT AS UserId NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    last_read_at INTEGER,
    latest_message_at INTEGER,
    -- NOTE: Result<> wrapper is for condition when parsing error. lower data is just MessagePreview
    latest_message_preview TEXT AS kotlin.Result<MessagePreview>,
    draft TEXT AS kotlin.Result<MessageDraft>
);

insertTopic:
INSERT INTO topics
VALUES :topicEntity;

insertMember:
INSERT
INTO topic_members
VALUES :topicMemberEntity;

insertPersonalPreference:
INSERT INTO topic_preference
VALUES :personalPreferenceEntity;

insertMessageState:
INSERT
INTO topic_message_state
VALUES :topicMessageStateEntity;

-- it will trigger all the referenced records
deleteTopic:
DELETE FROM topics
WHERE id = :topicId
  AND EXISTS (
      SELECT 1
      FROM topic_members
      WHERE topic_id = topics.id
        AND user_id = :triggerUserId
        AND role = :adminRoleValue
  );