import top.fseasy.imlog.domain.model.MessageId;
import top.fseasy.imlog.domain.model.StoragePathModel;
import top.fseasy.imlog.domain.model.TopicId;
import top.fseasy.imlog.domain.model.UserId;
import top.fseasy.imlog.domain.model.VoiceDraft;

-- Migrations:
-- 1. table `message_attachment_processing_task_states` (by table rebuild way):
--    - drop column src_uri
--    - add column src_path
--

---------
-- table `message_attachment_processing_task_states` migration
---------
-- 1. create new temp table
CREATE TABLE message_attachment_processing_task_states_new (
   message_id TEXT AS MessageId NOT NULL PRIMARY KEY REFERENCES messages(id) ON DELETE CASCADE,
   src_path TEXT AS StoragePathModel,
   internal_cached_filename TEXT,
   task_tart_time INTEGER NOT NULL,
   error_stage TEXT DEFAULT NULL,
   error_user_retryable INTEGER AS kotlin.Boolean DEFAULT NULL
);

-- 2. migrate data from old to new
-- 注：若旧数据中的 src_uri 格式可直接作为 src_path 复用，直接读取；
--    若历史中的任务无需迁移或格式不通用，可将 `src_uri AS src_path` 改为 `NULL AS src_path`
INSERT INTO message_attachment_processing_task_states_new (
    message_id,
    src_path,
    internal_cached_filename,
    task_tart_time,
    error_stage,
    error_user_retryable
)
SELECT
    message_id,
    src_uri AS src_path,
    internal_cached_filename,
    task_tart_time,
    error_stage,
    error_user_retryable
FROM message_attachment_processing_task_states;

-- 3. drop old
DROP TABLE message_attachment_processing_task_states;

-- 4. rename
ALTER TABLE message_attachment_processing_task_states_new RENAME TO message_attachment_processing_task_states;

---------
-- table `topic_message_state` migration
-- change draft structure
-- 1. delete draft(Result<MessageDraft>)
-- 2. add text_draft, voice_draft
---------
-- create temp
CREATE TABLE tmp_topic_message_state (
    topic_id TEXT AS TopicId NOT NULL REFERENCES topics(id) ON DELETE CASCADE,
    user_id TEXT AS UserId NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    last_read_message_id TEXT AS MessageId,
    draft_quoted_message_id TEXT AS MessageId,
    draft_text_content TEXT,
    -- Use Result to handle parsing error condition
    draft_voice_content TEXT AS kotlin.Result<VoiceDraft>,
    PRIMARY KEY (topic_id, user_id)
);
-- migration: NOTE, here we just dropped the old draft(Result<MessageDraft>).
--      it's recommended to register a callback to parse it and fill to the new field.
--      as currently it's in deving stage, no customer data, we just delete them.
INSERT INTO tmp_topic_message_state
    (topic_id, user_id, last_read_message_id)
SELECT topic_id, user_id, last_read_message_id
FROM topic_message_state;
-- delete old
DROP TABLE topic_message_state;
-- rename temp
ALTER TABLE tmp_topic_message_state RENAME TO topic_message_state;
