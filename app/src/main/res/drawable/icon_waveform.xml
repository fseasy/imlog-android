<!-- res/drawable/ic_waveform.xml -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="32dp"
    android:height="16dp"
    android:viewportWidth="32"
    android:viewportHeight="16">
    <!-- 
        6 根带有圆角端点的声波柱，高低错落呈现真实音频波形节奏
        利用 strokeLineCap="round" 保证端点完美圆润
    -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:pathData="
            M 3.5,6.0  V 10.0
            M 8.5,3.0  V 13.0
            M 13.5,1.5 V 14.5
            M 18.5,4.5 V 11.5
            M 23.5,2.5 V 13.5
            M 28.5,5.5 V 10.5
        " />
</vector>